{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "Portfolio.html",
          "components.jsx",
          "app.jsx",
          "data.js",
          "admin/**",
          "assets/**",
          "data/**",
          "pbcase-study/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}
